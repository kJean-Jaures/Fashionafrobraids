# Généré localement par npm run setup. Ne jamais versionner .env.local.
ADMIN_PASSWORD=
# Sans DATABASE_URL, le PostgreSQL embarqué PGlite persiste dans data/postgres.
# Utiliser une vraie base PostgreSQL pour une mise en ligne avec plusieurs instances.
DATABASE_URL=
# Facultatif : répertoires sur un disque persistant.
# DATA_DIR=/workspace/Fashionafrobraids/data/postgres
# UPLOAD_DIR=/workspace/Fashionafrobraids/data/uploads
# Adresse HTTPS du nouveau site une fois déployé.
PUBLIC_SITE_URL=
# Passer à true après validation des contenus et des informations légales.
ALLOW_INDEXING=false
# Activer uniquement pour un aperçu de test distinct du salon.
DEMO_MODE=false
# Envoi e-mail : ajouter la clé en configuration sécurisée, jamais dans Git.
RESEND_API_KEY=
EMAIL_FROM=
# Cron authentifié pour les rappels : générer un secret aléatoire dédié.
CRON_SECRET=
# Acompte de 10 € : carte bancaire et Apple Pay via SumUp Hosted Checkout.
# Créer un profil Sandbox et sa clé privée pour les essais.
# Le mode test vérifie auprès de SumUp que le profil est bien un Sandbox.
PAYMENT_PROVIDER=sumup
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_MODE=test
# Alternative conservée : PAYMENT_PROVIDER=paypal et compte marchand PayPal.
# Tester en sandbox d’abord.
# Valeurs sécurisées uniquement ; jamais dans Git ni le chat.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
